# ===========================================================================
# Elite Jinzai Marketing - Staff Portal configuration
# Copy to .env and adjust. After changing anything, rebuild:
#   docker compose up -d --build      (Docker)
#   restart "npm run dev"             (local)
#
# WARNING: every VITE_* value is built into the public JavaScript and can be
# read by anyone who opens the site. Never put real secrets in VITE_* vars.
# ===========================================================================

# --- Company branding -------------------------------------------------------
VITE_COMPANY_NAME="Elite Jinzai Marketing Services Inc."
VITE_COMPANY_SHORT_NAME="Elite Jinzai"
VITE_COMPANY_ADDRESS="Unit 4F Cypress Garden Bldg., 112 V.A. Rufino St., Legaspi Village, Makati City 1223"
VITE_COMPANY_ADDRESS_JA="マカティ市 レガスピ・ビレッジ V.A.ルフィノ通り112 サイプレス・ガーデン・ビル 4階（〒1223）"

# Contact details shown on the home page
VITE_COMPANY_PHONES="+63 (02) 8893-6251,+63 (02) 8519-2394"
VITE_FACEBOOK_URL=https://www.facebook.com/recruitELITE/

# --- Language ---------------------------------------------------------------
# Default language for first-time visitors: en (English) or ja (Japanese).
# Each visitor can switch in the language menu; their choice is remembered.
VITE_DEFAULT_LANGUAGE=en

# Default theme for first-time visitors: system (follow the device), light or dark.
VITE_DEFAULT_THEME=system

# --- Demo login (NOT secure - for demos only) -------------------------------
VITE_DEMO_USER=admin
VITE_DEMO_PASS=change-me

# Browser sessionStorage key that remembers the signed-in user
VITE_SESSION_KEY=ej-user

# Fill the portal with fake demo data on first start: true or false
VITE_DEMO_DATA=true

# --- Docker -----------------------------------------------------------------
# Port on your computer where the site is served: http://localhost:<WEB_PORT>
WEB_PORT=3000
