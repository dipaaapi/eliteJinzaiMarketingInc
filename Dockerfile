# Build stage
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY public ./public
COPY index.html vite.config.js ./
COPY src ./src
ARG VITE_COMPANY_NAME
ARG VITE_COMPANY_SHORT_NAME
ARG VITE_COMPANY_ADDRESS
ARG VITE_COMPANY_ADDRESS_JA
ARG VITE_COMPANY_PHONES
ARG VITE_FACEBOOK_URL
ARG VITE_DEMO_USER
ARG VITE_DEMO_PASS
ARG VITE_SESSION_KEY
ARG VITE_DEFAULT_LANGUAGE
ARG VITE_DEFAULT_THEME
ARG VITE_DEMO_DATA
ENV VITE_COMPANY_NAME=$VITE_COMPANY_NAME VITE_COMPANY_SHORT_NAME=$VITE_COMPANY_SHORT_NAME VITE_COMPANY_ADDRESS=$VITE_COMPANY_ADDRESS VITE_COMPANY_ADDRESS_JA=$VITE_COMPANY_ADDRESS_JA VITE_COMPANY_PHONES=$VITE_COMPANY_PHONES VITE_FACEBOOK_URL=$VITE_FACEBOOK_URL VITE_DEMO_USER=$VITE_DEMO_USER VITE_DEMO_PASS=$VITE_DEMO_PASS VITE_SESSION_KEY=$VITE_SESSION_KEY VITE_DEFAULT_LANGUAGE=$VITE_DEFAULT_LANGUAGE VITE_DEFAULT_THEME=$VITE_DEFAULT_THEME VITE_DEMO_DATA=$VITE_DEMO_DATA
RUN npm run build

# Serve stage
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
